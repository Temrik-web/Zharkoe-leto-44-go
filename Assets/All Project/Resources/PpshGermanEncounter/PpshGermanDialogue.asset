  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5b10eef72775f734787ca02c4ae93b61, type: 3}
  m_Name: PpshGermanDialogue
  m_EditorClassIdentifier:
  dialogueName: "ППШ — немец за дверью"
  description: "После подбора ППШ за дверью стучит немец из налёта: требует побор — хлеб, воду, табак. Согласие — уходит, отказ — свист и шестеро из засады."
  completionQuestId:
  nodes:
  - nodeID: N1
    nextNodeID: N2
    speakerName: "Немец"
    speakerPortrait: {fileID: 0}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    dialogueText: "Halt! Nicht schießen! Tür auf — открывай. Brot, Wasser, Tabak — всё сюда, и быстро. Мы уже в селе, Soldat: второй раз я стучать не буду."
    voiceClip: {fileID: 0}
    germanAccent: 1
    textSpeed: 0
    autoAdvanceDelay: 0
    onEnterCommands: []
    choices: []
    onNodeEnter:
      m_PersistentCalls:
        m_Calls: []
    onNodeExit:
      m_PersistentCalls:
        m_Calls: []
  - nodeID: N2
    nextNodeID: N3
    speakerName: "Алесь"
    speakerPortrait: {fileID: 0}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    dialogueText: "Стой. Не подходи. Кто ты такой и почему я должен тебе что-то давать?"
    voiceClip: {fileID: 0}
    germanAccent: 0
    textSpeed: 0
    autoAdvanceDelay: 0
    onEnterCommands: []
    choices: []
    onNodeEnter:
      m_PersistentCalls:
        m_Calls: []
    onNodeExit:
      m_PersistentCalls:
        m_Calls: []
  - nodeID: N3
    nextNodeID: N4
    speakerName: "Немец"
    speakerPortrait: {fileID: 0}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    dialogueText: "Ich bin Hans — рядовой. Взвод разбили у шоссе, теперь я собираю побор по деревне. Не отдашь по-хорошему — заберу сам. Brot, Wasser und Tabak — и я уйду."
    voiceClip: {fileID: 0}
    germanAccent: 1
    textSpeed: 0
    autoAdvanceDelay: 0
    onEnterCommands: []
    choices: []
    onNodeEnter:
      m_PersistentCalls:
        m_Calls: []
    onNodeExit:
      m_PersistentCalls:
        m_Calls: []
  - nodeID: N4
    nextNodeID: ""
    speakerName: "Немец"
    speakerPortrait: {fileID: 0}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    dialogueText: "Ну? Schnell, Soldat: у меня ещё полдеревни впереди."
    voiceClip: {fileID: 0}
    germanAccent: 1
    textSpeed: 0
    autoAdvanceDelay: 0
    onEnterCommands: []
    choices:
    - choiceText: "Где твои? Сколько вас?"
      condition: {fileID: 0}
      requiredItemId:
      requiredItemCount: 1
      requiredItems: []
      requiredQuestId:
      requiredQuestState: 1
      showWhenLocked: 0
      nextNodeID: N4_where
      endDialogue: 0
      onSelectCommands: []
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - choiceText: "Держи хлеб и флягу. И уходи."
      condition: {fileID: 0}
      requiredItemId:
      requiredItemCount: 1
      requiredItems:
      - itemId: bread
        count: 1
      - itemId: water
        count: 1
      requiredQuestId:
      requiredQuestState: 1
      showWhenLocked: 1
      nextNodeID: N5_agree
      endDialogue: 0
      onSelectCommands:
      - type: 4
        stringParam: bread
        stringValueParam:
        boolParam: 0
        intParam: 1
        floatParam: 0
        gameObjectParam: {fileID: 0}
        clipParam: {fileID: 0}
        spriteParam: {fileID: 0}
      - type: 4
        stringParam: water
        stringValueParam:
        boolParam: 0
        intParam: 1
        floatParam: 0
        gameObjectParam: {fileID: 0}
        clipParam: {fileID: 0}
        spriteParam: {fileID: 0}
      - type: 10
        stringParam: ppsh_german_agreed
        stringValueParam:
        boolParam: 0
        intParam: 0
        floatParam: 0
        gameObjectParam: {fileID: 0}
        clipParam: {fileID: 0}
        spriteParam: {fileID: 0}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - choiceText: "Ничего ты здесь не получишь. Убирайся!"
      condition: {fileID: 0}
      requiredItemId:
      requiredItemCount: 1
      requiredItems: []
      requiredQuestId:
      requiredQuestState: 1
      showWhenLocked: 0
      nextNodeID: N5_refuse
      endDialogue: 0
      onSelectCommands:
      - type: 10
        stringParam: ppsh_german_refused
        stringValueParam:
        boolParam: 0
        intParam: 0
        floatParam: 0
        gameObjectParam: {fileID: 0}
        clipParam: {fileID: 0}
        spriteParam: {fileID: 0}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - choiceText: "Ещё шаг — и я выстрелю!"
      condition: {fileID: 0}
      requiredItemId:
      requiredItemCount: 1
      requiredItems: []
      requiredQuestId:
      requiredQuestState: 1
      showWhenLocked: 0
      nextNodeID: N5_fight
      endDialogue: 0
      onSelectCommands:
      - type: 10
        stringParam: ppsh_german_refused
        stringValueParam:
        boolParam: 0
        intParam: 0
        floatParam: 0
        gameObjectParam: {fileID: 0}
        clipParam: {fileID: 0}
        spriteParam: {fileID: 0}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    onNodeEnter:
      m_PersistentCalls:
        m_Calls: []
    onNodeExit:
      m_PersistentCalls:
        m_Calls: []
  - nodeID: N4_where
    nextNodeID: N4
    speakerName: "Немец"
    speakerPortrait: {fileID: 0}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    dialogueText: "За огородами, у берёзы. Sechs Mann — шестеро. Пока мы говорим, они уже вскрыли первую избу. Так что не тяни, Soldat: они не ждут."
    voiceClip: {fileID: 0}
    germanAccent: 1
    textSpeed: 0
    autoAdvanceDelay: 0
    onEnterCommands: []
    choices: []
    onNodeEnter:
      m_PersistentCalls:
        m_Calls: []
    onNodeExit:
      m_PersistentCalls:
        m_Calls: []
  - nodeID: N5_agree
    nextNodeID: ""
    speakerName: "Немец"
    speakerPortrait: {fileID: 0}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    dialogueText: "Gut. Хлеб и воду забираю. Не шуми и дверь больше не открывай. Мы ещё проверим остальные дома. Auf Wiedersehen."
    voiceClip: {fileID: 0}
    germanAccent: 1
    textSpeed: 0
    autoAdvanceDelay: 0
    onEnterCommands: []
    choices: []
    onNodeEnter:
      m_PersistentCalls:
        m_Calls: []
    onNodeExit:
      m_PersistentCalls:
        m_Calls: []
  - nodeID: N5_refuse
    nextNodeID: ""
    speakerName: "Немец"
    speakerPortrait: {fileID: 0}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    dialogueText: "Wie bitte? Ты отказываешься выполнять приказ? Хорошо. Kameraden! Сюда! В этом доме сопротивление! Сейчас сами всё заберём!"
    voiceClip: {fileID: 0}
    germanAccent: 1
    textSpeed: 0
    autoAdvanceDelay: 0
    onEnterCommands: []
    choices: []
    onNodeEnter:
      m_PersistentCalls:
        m_Calls: []
    onNodeExit:
      m_PersistentCalls:
        m_Calls: []
  - nodeID: N5_fight
    nextNodeID: ""
    speakerName: "Немец"
    speakerPortrait: {fileID: 0}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    dialogueText: "Du willst kämpfen? Сам напросился! Kameraden, сюда! Schnell! К двери, живо! Feuer!"
    voiceClip: {fileID: 0}
    germanAccent: 1
    textSpeed: 0
    autoAdvanceDelay: 0
    onEnterCommands: []
    choices: []
    onNodeEnter:
      m_PersistentCalls:
        m_Calls: []
    onNodeExit:
      m_PersistentCalls:
        m_Calls: []
